{
  "expo": {
    "name": "Shaggoth AI",
    "slug": "shaggoth-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#000000",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mattjhagen.shaggoth",
      "buildNumber": "2",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSSpeechRecognitionUsageDescription": "Shaggoth uses speech recognition so you can talk to it instead of typing.",
        "NSMicrophoneUsageDescription": "Shaggoth needs microphone access for voice input."
      }
    },
    "android": {
      "package": "com.relayapp.pro",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#0D0D12",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": ["RECORD_AUDIO"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "shaggoth" }],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "android.intent.action.ASSIST",
          "category": ["DEFAULT"]
        }
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#7C3AED"
        }
      ],
      "./plugins/withAndroidAssistant",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Shaggoth needs microphone access for voice input.",
          "speechRecognitionPermission": "Shaggoth uses speech recognition so you can talk to it instead of typing."
        }
      ]
    ]
  }
}
